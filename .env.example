# Local-only credentials for docker-compose.yml. Change these before sharing a network.
MYSQL_ROOT_PASSWORD=mm_root_dev_password
MYSQL_APP_PASSWORD=mm_dev_password
MSSQL_SA_PASSWORD=Mssql_dev_2026!

# RabbitMQ local development account.
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# API gateway local environment.
FRONTEND_BASE_URL=http://localhost:5173
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_REQUESTS=60
GATEWAY_RATE_LIMIT_WINDOW=PT1M
REDIS_HOST=localhost
REDIS_PORT=6379
