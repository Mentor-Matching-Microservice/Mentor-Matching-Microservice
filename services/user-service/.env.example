# Reference values only. Spring Boot does not automatically load .env.
# Export variables in the shell or configure the IDE run environment.
SERVER_PORT=8082
USER_DB_PORT=3308
DB_URL=jdbc:mysql://localhost:3308/mm_user?connectionTimeZone=UTC
DB_USERNAME=mm_user
DB_PASSWORD=replace-with-your-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/
API_DOCS_ENABLED=false

# Audience must match auth-service; only the public key is needed here.
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=mentor-matching-api
AUTH_JWT_PUBLIC_KEY_LOCATION=file:../auth-service/jwt-keys/public.pem
USER_CORS_ALLOWED_ORIGINS=http://localhost:5173
