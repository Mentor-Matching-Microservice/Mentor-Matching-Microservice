# Reference values only. Spring Boot does not automatically load .env.
# Export variables in the shell or configure the IDE run environment.
SERVER_PORT=8083
DB_URL='jdbc:mysql://localhost:3309/mm_mentor?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
DB_USERNAME=mm_mentor
DB_PASSWORD=replace-with-your-local-database-password
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/
API_DOCS_ENABLED=false

# Local Docker Compose only
MENTOR_DB_PORT=3309
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password

# Match auth-service token settings; mentor-service needs only the public key.
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=mentor-matching-api
AUTH_JWT_PUBLIC_KEY_LOCATION=file:../auth-service/jwt-keys/public.pem
MENTOR_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Enable with auth-service internal account sync and use the same random secret.
MENTOR_ACCOUNT_SYNC_ENABLED=false
MENTOR_ACCOUNT_SYNC_BASE_URL=http://localhost:8081
# MENTOR_ACCOUNT_SYNC_TOKEN=replace-with-the-auth-internal-secret
