{
  "info": {
    "_postman_id": "17cce4d1-4a2d-41d8-9433-b2148ffcc116",
    "name": "Discovery Service (Eureka) - Verification",
    "description": "Verification collection for services/discovery-service (issue #58).\n\nRun folders in order. Requires network access to the registry (local machine or the internal Docker network); the registry must not be exposed publicly.\n\nCredentials come ONLY from the selected environment (`discoveryUsername`, `discoveryPassword`). Never save real values in this collection.\n\nFolder 03 registers a fake instance (`sampleApp` / `sampleInstanceId`) and removes it at the end. Do not run it against a shared or production registry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{discoveryUsername}}", "type": "string" },
      { "key": "password", "value": "{{discoveryPassword}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "01 Public health probes",
      "description": "The only endpoints reachable without credentials. Details are never exposed.",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK without credentials', () => pm.response.to.have.status(200));",
              "pm.test('status is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));",
              "pm.test('no component details exposed', () => pm.expect(pm.response.text()).to.not.include('components'));"
            ]}
          }]
        },
        {
          "name": "Readiness probe",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/actuator/health/readiness", "host": ["{{baseUrl}}"], "path": ["actuator", "health", "readiness"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });"
            ]}
          }]
        },
        {
          "name": "Liveness probe",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/actuator/health/liveness", "host": ["{{baseUrl}}"], "path": ["actuator", "health", "liveness"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });"
            ]}
          }]
        }
      ]
    },
    {
      "name": "02 Access control (must be rejected)",
      "description": "Each request is expected to FAIL with 401. A 2xx here is a security defect.",
      "item": [
        {
          "name": "Registry API without credentials",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/eureka/apps", "host": ["{{baseUrl}}"], "path": ["eureka", "apps"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('Basic challenge present', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.match(/^Basic realm=\"discovery-service\"/));",
              "pm.test('no registry data leaked', () => pm.expect(pm.response.text()).to.eql(''));"
            ]}
          }]
        },
        {
          "name": "Registry API with wrong password",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{discoveryUsername}}", "type": "string" },
                { "key": "password", "value": "wrong-{{$guid}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/eureka/apps", "host": ["{{baseUrl}}"], "path": ["eureka", "apps"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]}
          }]
        },
        {
          "name": "Register instance without credentials",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"instance\":{\"instanceId\":\"anonymous:1\",\"app\":\"ANONYMOUS-SERVICE\"}}" },
            "url": { "raw": "{{baseUrl}}/eureka/apps/ANONYMOUS-SERVICE", "host": ["{{baseUrl}}"], "path": ["eureka", "apps", "ANONYMOUS-SERVICE"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]}
          }]
        },
        {
          "name": "Actuator info without credentials",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/actuator/info", "host": ["{{baseUrl}}"], "path": ["actuator", "info"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('ProblemDetail body', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  pm.expect(pm.response.json().code).to.eql('AUTHENTICATION_REQUIRED');",
              "});"
            ]}
          }]
        },
        {
          "name": "Dashboard without credentials",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401 Unauthorized (enabled or not)', () => pm.response.to.have.status(401));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "03 Registry with internal credentials",
      "description": "Uses the collection Basic auth (environment variables). Registers a fake instance, inspects it, sends a heartbeat, marks it OUT_OF_SERVICE, then cancels it.",
      "item": [
        {
          "name": "List registered applications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/eureka/apps", "host": ["{{baseUrl}}"], "path": ["eureka", "apps"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('registry document returned', () => pm.expect(pm.response.json()).to.have.property('applications'));",
              "pm.test('no session cookie issued', () => pm.expect(pm.response.headers.has('Set-Cookie')).to.be.false);"
            ]}
          }]
        },
        {
          "name": "Register sample instance",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instance\": {\n    \"instanceId\": \"{{sampleInstanceId}}\",\n    \"hostName\": \"localhost\",\n    \"app\": \"{{sampleApp}}\",\n    \"ipAddr\": \"127.0.0.1\",\n    \"status\": \"UP\",\n    \"port\": { \"$\": 18099, \"@enabled\": \"true\" },\n    \"securePort\": { \"$\": 443, \"@enabled\": \"false\" },\n    \"vipAddress\": \"postman-sample-service\",\n    \"dataCenterInfo\": { \"@class\": \"com.netflix.appinfo.InstanceInfo$DefaultDataCenterInfo\", \"name\": \"MyOwn\" },\n    \"leaseInfo\": { \"renewalIntervalInSecs\": 30, \"durationInSecs\": 90 },\n    \"metadata\": { \"version\": \"1.0.0\", \"registeredBy\": \"postman\" }\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/eureka/apps/{{sampleApp}}", "host": ["{{baseUrl}}"], "path": ["eureka", "apps", "{{sampleApp}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('204 No Content (registered)', () => pm.response.to.have.status(204));"
            ]}
          }]
        },
        {
          "name": "Inspect registered instance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/eureka/apps/{{sampleApp}}/{{sampleInstanceId}}", "host": ["{{baseUrl}}"], "path": ["eureka", "apps", "{{sampleApp}}", "{{sampleInstanceId}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const instance = pm.response.json().instance;",
              "pm.test('status UP', () => pm.expect(instance.status).to.eql('UP'));",
              "pm.test('metadata preserved', () => pm.expect(instance.metadata.version).to.eql('1.0.0'));",
              "pm.test('lease information present', () => pm.expect(instance.leaseInfo.durationInSecs).to.eql(90));"
            ]}
          }]
        },
        {
          "name": "Send heartbeat",
          "request": {
            "method": "PUT",
            "header": [],
            "url": { "raw": "{{baseUrl}}/eureka/apps/{{sampleApp}}/{{sampleInstanceId}}?status=UP", "host": ["{{baseUrl}}"], "path": ["eureka", "apps", "{{sampleApp}}", "{{sampleInstanceId}}"], "query": [{ "key": "status", "value": "UP" }] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK (lease renewed)', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "Mark instance OUT_OF_SERVICE",
          "request": {
            "method": "PUT",
            "header": [],
            "url": { "raw": "{{baseUrl}}/eureka/apps/{{sampleApp}}/{{sampleInstanceId}}/status?value=OUT_OF_SERVICE", "host": ["{{baseUrl}}"], "path": ["eureka", "apps", "{{sampleApp}}", "{{sampleInstanceId}}", "status"], "query": [{ "key": "value", "value": "OUT_OF_SERVICE" }] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "Verify instance is OUT_OF_SERVICE",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/eureka/apps/{{sampleApp}}/{{sampleInstanceId}}", "host": ["{{baseUrl}}"], "path": ["eureka", "apps", "{{sampleApp}}", "{{sampleInstanceId}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status OUT_OF_SERVICE', () => pm.expect(pm.response.json().instance.status).to.eql('OUT_OF_SERVICE'));"
            ]}
          }]
        },
        {
          "name": "Remove OUT_OF_SERVICE override",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/eureka/apps/{{sampleApp}}/{{sampleInstanceId}}/status?value=UP", "host": ["{{baseUrl}}"], "path": ["eureka", "apps", "{{sampleApp}}", "{{sampleInstanceId}}", "status"], "query": [{ "key": "value", "value": "UP" }] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "Cancel (deregister) sample instance",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/eureka/apps/{{sampleApp}}/{{sampleInstanceId}}", "host": ["{{baseUrl}}"], "path": ["eureka", "apps", "{{sampleApp}}", "{{sampleInstanceId}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK (cancelled)', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "Verify instance is gone",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/eureka/apps/{{sampleApp}}/{{sampleInstanceId}}", "host": ["{{baseUrl}}"], "path": ["eureka", "apps", "{{sampleApp}}", "{{sampleInstanceId}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "04 Management surface with internal credentials",
      "description": "Even authenticated callers cannot reach sensitive actuator endpoints; they are not exposed at all.",
      "item": [
        {
          "name": "Actuator info",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/actuator/info", "host": ["{{baseUrl}}"], "path": ["actuator", "info"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "Actuator env is not exposed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/actuator/env", "host": ["{{baseUrl}}"], "path": ["actuator", "env"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]}
          }]
        },
        {
          "name": "Actuator heapdump is not exposed",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/heapdump", "host": ["{{baseUrl}}"], "path": ["actuator", "heapdump"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]}
          }]
        },
        {
          "name": "Dashboard (depends on EUREKA_DASHBOARD_ENABLED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.environment.get('dashboardEnabled') === 'true') {",
              "  pm.test('200 OK and dashboard rendered', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.text()).to.include('Instances currently registered with Eureka');",
              "  });",
              "} else {",
              "  pm.test('404 Not Found (dashboard disabled)', () => pm.response.to.have.status(404));",
              "}"
            ]}
          }]
        }
      ]
    }
  ]
}
