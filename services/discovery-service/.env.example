# Reference values only. Spring Boot does not automatically load .env.
# Export variables in the shell or configure the IDE run environment.
SERVER_PORT=8761
# Hostname other services use to reach the registry (use the container/service name in Docker).
EUREKA_INSTANCE_HOSTNAME=localhost

# Required internal account for the registry API and dashboard. No default exists:
# the service refuses to start without both values.
# Username: letters, digits, '.', '_' or '-'. Password: 16-72 bytes, generate a random value,
# for example: openssl rand -base64 33 | tr '+/' '-_'
DISCOVERY_USERNAME=discovery
DISCOVERY_PASSWORD=replace-with-a-strong-random-secret

# Local development conveniences. Keep the production defaults (false / true) outside local runs.
EUREKA_DASHBOARD_ENABLED=true
EUREKA_SELF_PRESERVATION=false
EUREKA_EVICTION_INTERVAL_MS=5000
EUREKA_RESPONSE_CACHE_UPDATE_INTERVAL_MS=5000
