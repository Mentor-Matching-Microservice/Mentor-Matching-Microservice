{
  "info": {
    "_postman_id": "4f0d8a3e-6b2c-4c1e-9a57-2d7e3b9c8f14",
    "name": "notification-service (foundation #62)",
    "description": "Kiểm tra nền tảng notification-service: health công khai, bảo mật Bearer JWT RS256, hợp đồng lỗi ProblemDetail và handshake STOMP. API thông báo (/api/v1/notifications) được bổ sung ở #73.\n\nBiến môi trường cần có: baseUrl, accessToken (access token hợp lệ do auth-service cấp, ví dụ lấy từ POST /api/v1/auth/login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public probes",
      "item": [
        {
          "name": "Health",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/actuator/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('UP without details', () => { const b = pm.response.json(); pm.expect(b.status).to.eql('UP'); pm.expect(b).to.not.have.property('components'); });"
          ] } }]
        },
        {
          "name": "Readiness (includes MongoDB)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/actuator/health/readiness" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200 UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });"
          ] } }]
        },
        {
          "name": "Liveness",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/actuator/health/liveness" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200 UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "2. Rejected access",
      "item": [
        {
          "name": "No token → 401 ProblemDetail",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/v1/notifications" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 401', () => pm.response.to.have.status(401));",
            "pm.test('Bearer challenge', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer'));",
            "pm.test('ProblemDetail AUTHENTICATION_REQUIRED', () => {",
            "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
            "  const b = pm.response.json();",
            "  pm.expect(b.code).to.eql('AUTHENTICATION_REQUIRED');",
            "  pm.expect(b.requestId).to.eql(pm.response.headers.get('X-Request-ID'));",
            "});"
          ] } }]
        },
        {
          "name": "Malformed token → 401",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "not.a.jwt", "type": "string" }] },
            "method": "GET", "url": "{{baseUrl}}/api/v1/notifications"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 401', () => pm.response.to.have.status(401));",
            "pm.test('code AUTHENTICATION_REQUIRED', () => pm.expect(pm.response.json().code).to.eql('AUTHENTICATION_REQUIRED'));"
          ] } }]
        },
        {
          "name": "WebSocket handshake without token → 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Connection", "value": "Upgrade" },
              { "key": "Upgrade", "value": "websocket" },
              { "key": "Sec-WebSocket-Version", "value": "13" },
              { "key": "Sec-WebSocket-Key", "value": "dGhlIHNhbXBsZSBub25jZQ==" }
            ],
            "url": "{{baseUrl}}/ws/notifications"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 401', () => pm.response.to.have.status(401));"
          ] } }]
        }
      ]
    },
    {
      "name": "3. Authenticated (Bearer accessToken)",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Actuator info",
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/info" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200 (token accepted)', () => pm.response.to.have.status(200));"
          ] } }]
        },
        {
          "name": "Unknown route → 404 ProblemDetail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/does-not-exist" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 404', () => pm.response.to.have.status(404));",
            "pm.test('ProblemDetail RESOURCE_NOT_FOUND', () => {",
            "  const b = pm.response.json();",
            "  pm.expect(b.code).to.eql('RESOURCE_NOT_FOUND');",
            "  pm.expect(b.type).to.eql('urn:mentor-matching:problem:resource-not-found');",
            "  pm.expect(b.instance).to.eql('/api/v1/does-not-exist');",
            "  pm.expect(b.requestId).to.eql(pm.response.headers.get('X-Request-ID'));",
            "});"
          ] } }]
        },
        {
          "name": "Sensitive actuator endpoints are not exposed",
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/env" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 404', () => pm.response.to.have.status(404));"
          ] } }]
        },
        {
          "name": "API docs disabled by default",
          "request": { "method": "GET", "url": "{{baseUrl}}/v3/api-docs" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 404', () => pm.response.to.have.status(404));"
          ] } }]
        }
      ]
    }
  ]
}
