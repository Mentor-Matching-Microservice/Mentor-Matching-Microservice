# notification-service — copy to .env (never commit .env) and fill in real values.

SERVER_PORT=8089

# MongoDB replica set (transactions required). Put credentials in the URI, e.g.
# mongodb://<user>:<password>@localhost:27017/mm_notification?replicaSet=rs0&authSource=admin
MONGODB_URI=mongodb://localhost:27017/mm_notification?replicaSet=rs0
MONGODB_AUTO_INDEX_CREATION=true

# JWT issued by auth-service (RS256). Must match auth-service AUTH_JWT_ISSUER / AUTH_JWT_AUDIENCE.
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=replace-with-the-auth-service-audience
# Public key only (X.509 PEM). Local dev from services/notification-service:
AUTH_JWT_PUBLIC_KEY_LOCATION=file:../auth-service/jwt-keys/public.pem

# RabbitMQ (same variable names as payment-service). guest/guest only works from localhost.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
# Event consumption: shared exchange, private queue (+ .dlx / .dead), routing keys bound to the queue.
NOTIFICATION_MESSAGING_ENABLED=true
NOTIFICATION_EVENTS_EXCHANGE=mentor.events
NOTIFICATION_EVENTS_QUEUE=notification.domain-events
NOTIFICATION_EVENTS_ROUTING_KEYS=auth.#,mentor.#,booking.#,payment.#,review.#
NOTIFICATION_EVENTS_MAX_RETRIES=4
# booking-service internal API used to resolve learner/mentor of a booking (read-only call).
BOOKING_SERVICE_URL=http://localhost:8084
BOOKING_CONNECT_TIMEOUT=2s
BOOKING_READ_TIMEOUT=3s
# Realtime push retry (each attempt is recorded in delivery_attempts).
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=3
NOTIFICATION_DELIVERY_INITIAL_BACKOFF=200ms

# Frontend origin(s) allowed for CORS and the STOMP handshake (comma separated).
NOTIFICATION_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Service discovery (discovery-service requires HTTP Basic credentials in the URL).
EUREKA_ENABLED=false
EUREKA_URL=http://discovery:replace-with-discovery-password@localhost:8761/eureka/

API_DOCS_ENABLED=false
