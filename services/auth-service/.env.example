# Reference values only. Spring Boot does not automatically load .env.
# Export variables in the shell or configure the IDE run environment.
SERVER_PORT=8081
DB_URL=jdbc:mysql://localhost:3306/mm_auth
DB_USERNAME=mm_auth
DB_PASSWORD=replace-with-your-local-database-password
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/
API_DOCS_ENABLED=false

# Set these before using TokenService. TTLs use Spring duration syntax, e.g. 15m or 7d.
AUTH_JWT_ISSUER=auth-service
# AUTH_JWT_AUDIENCE=mentor-matching-api
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=30d
# Path to a PKCS#8 PEM RSA private key (at least 2048 bits).
# AUTH_JWT_PRIVATE_KEY_PATH=/absolute/path/to/jwt-keys/private.pem

# Browser origins that may call auth endpoints (comma-separated).
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict

# Internal account status and mentor role grant endpoints. Use the same random secret in mentor-service.
AUTH_INTERNAL_ACCOUNT_SYNC_ENABLED=false
# AUTH_INTERNAL_ACCOUNT_SYNC_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# One-time links (#63): lifetimes and minimum delay between two emails for the same account.
AUTH_EMAIL_VERIFICATION_TTL=24h
AUTH_PASSWORD_RESET_TTL=30m
AUTH_EMAIL_RESEND_COOLDOWN=60s
# Email delivery. false = no email is sent (only a log line, never the token).
AUTH_MAIL_ENABLED=false
AUTH_MAIL_FROM=no-reply@mentor-matching.local
AUTH_VERIFY_EMAIL_URL=http://localhost:5173/verify-email
AUTH_RESET_PASSWORD_URL=http://localhost:5173/reset-password
# SMTP settings when AUTH_MAIL_ENABLED=true
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=replace-with-smtp-user
# SPRING_MAIL_PASSWORD=replace-with-smtp-password
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Local development only, with AUTH_MAIL_ENABLED=false: print verify/reset links to the log.
AUTH_MAIL_LOG_LINKS=false

# RabbitMQ (#64): outbox publishing and MentorApproved consumer. Same variable names as payment-service.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
AUTH_MESSAGING_ENABLED=true
AUTH_EVENTS_EXCHANGE=mentor.events
AUTH_EVENTS_QUEUE=auth.mentor-events
AUTH_EVENTS_ROUTING_KEYS=mentor.#
AUTH_EVENTS_MAX_RETRIES=4
AUTH_EVENTS_CONFIRM_TIMEOUT=5s
AUTH_OUTBOX_PUBLISH_DELAY=2s
RABBITMQ_CONNECTION_TIMEOUT=5s
RABBITMQ_CHANNEL_RPC_TIMEOUT=5s
