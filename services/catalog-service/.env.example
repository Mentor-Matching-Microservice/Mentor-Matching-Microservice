# Spring Boot does not automatically load .env. Export these variables or configure your IDE.
SERVER_PORT=8087
DB_URL='jdbc:mysql://localhost:3310/mm_catalog?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
DB_USERNAME=mm_catalog
DB_PASSWORD=replace-with-your-local-database-password

# Local Docker Compose only
CATALOG_DB_PORT=3310
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password

# Public key and audience must match auth-service's JWT configuration.
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=mentor-matching
AUTH_JWT_PUBLIC_KEY_LOCATION=file:/absolute/path/to/auth-public.pem
